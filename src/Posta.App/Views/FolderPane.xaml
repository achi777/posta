<UserControl x:Class="Posta.App.Views.FolderPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Posta.App.ViewModels"
             Background="{StaticResource FolderPaneBrush}">
    <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="0,4,0,8"
              ItemContainerStyle="{StaticResource FolderTreeItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectedItemChanged="Tree_SelectedItemChanged"
              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
              AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Tree_DragLeave"
              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseMove="Tree_PreviewMouseMove">
        <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                <Grid x:Name="Row" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#605E5C" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" Foreground="#252423" />
                    <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="8,0,2,0" VerticalAlignment="Center" FontSize="12.5" />
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBold}" Value="True">
                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CountIsTotal}" Value="True">
                        <Setter TargetName="Count" Property="Foreground" Value="#107C10" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Name" Property="FontSize" Value="13.5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#CCE4F7" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </TreeView.Resources>
    </TreeView>
</UserControl>
