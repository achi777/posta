<UserControl x:Class="Posta.App.Views.ReadingPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Posta.App.Infrastructure"
             xmlns:c="clr-namespace:Posta.App.Controls"
             Background="White">
    <Grid>
        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="56" Foreground="#C8C6C4" HorizontalAlignment="Center" />
            <TextBlock Text="{ui:Loc SelectItemToRead}" FontSize="15" Foreground="#605E5C" Margin="0,12,0,4" HorizontalAlignment="Center" />
            <Button x:Name="AlwaysPreviewLink" Style="{StaticResource LinkButton}" Content="{ui:Loc ClickToAlwaysPreview}" HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <Grid x:Name="ContentRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="18,12,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <ItemsControl x:Name="CategoryChips" DockPanel.Dock="Right" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Converter={StaticResource CategoryColor}}" CornerRadius="2" Padding="6,1" Margin="4,2,0,0">
                                    <TextBlock Text="{Binding Converter={StaticResource LocKey}}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SubjectText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Ellipse x:Name="AvatarCircle" Fill="#0F6CBD" />
                        <TextBlock x:Name="AvatarText" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="AvatarPhoto" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run x:Name="FromName" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <Run x:Name="FromAddress" Foreground="{StaticResource TextSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="OnBehalfText" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ToLine" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock x:Name="CcLine" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" Click="Reply_Click" ToolTip="{ui:Loc Reply}" Padding="7,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8CA;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#5C2E91" VerticalAlignment="Center" />
                                    <TextBlock Text="{ui:Loc Reply}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="ReplyAll_Click" ToolTip="{ui:Loc ReplyAll}" Padding="7,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C2;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#5C2E91" VerticalAlignment="Center" />
                                    <TextBlock Text="{ui:Loc ReplyAll}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="Forward_Click" ToolTip="{ui:Loc Forward}" Padding="7,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE89C;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#0F6CBD" VerticalAlignment="Center" />
                                    <TextBlock Text="{ui:Loc Forward}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource FlatButton}" Click="More_Click" Padding="7,4" ToolTip="{ui:Loc More}">
                                <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="DateText" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,4,6,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Info bars -->
            <StackPanel x:Name="InfoBars" Grid.Row="1" Margin="18,0,14,4" />

            <!-- Attachments -->
            <ItemsControl x:Name="AttachmentList" Grid.Row="2" Margin="14,0,14,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="14,0,0,0">
                <c:HtmlView x:Name="Body" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
