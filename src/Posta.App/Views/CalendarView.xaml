<UserControl x:Class="Posta.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Posta.App.Infrastructure"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Navigation header -->
        <DockPanel Margin="10,8,10,6">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="240" Style="{StaticResource SearchBox}" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Click="Prev_Click" Padding="8,4" ToolTip="◀">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="Next_Click" Padding="8,4" ToolTip="▶">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <TextBlock x:Name="RangeTitle" FontSize="20" FontWeight="Light" Margin="12,0,0,2" VerticalAlignment="Center" />
                <ProgressBar x:Name="LoadingBar" Width="60" Height="3" IsIndeterminate="True" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Background="Transparent" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="Host" />
        </Border>
        <TextBlock x:Name="InfoText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#605E5C" Visibility="Collapsed" TextWrapping="Wrap" />
    </Grid>
</UserControl>
