    <Company>Archil Odishelidze</Company>
    <Copyright>© 2026 Archil Odishelidze</Copyright>
    <Description>Desktop mail client for Microsoft Exchange</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\posta.ico" />
    <Resource Include="Assets\posta-256.png" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third-party/mapi-client-rs/LICENSE-MIT.txt" Link="licenses/mapi-client-rs-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third-party/mimekit/LICENSE-MIT.txt" Link="licenses/MimeKit-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
