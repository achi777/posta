<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Posta.Core\Posta.Core.csproj" />
    <ProjectReference Include="..\Posta.Exchange\Posta.Exchange.csproj" />
    <ProjectReference Include="..\Posta.Outlook\Posta.Outlook.csproj" />
    <ProjectReference Include="..\Posta.Mapi\Posta.Mapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Fluent.Ribbon" Version="11.0.2" />
